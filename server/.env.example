PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-at-least-32-random-bytes
MEDIA_DIR=./media
MAX_UPLOAD_MB=20
CLIENT_ORIGIN=http://localhost:4200
COOKIE_SAME_SITE=Strict
# Only set behind a trusted reverse proxy; for example, 1 when one proxy is configured.
TRUST_PROXY=
ADMIN_NAME=Visualizer Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding
